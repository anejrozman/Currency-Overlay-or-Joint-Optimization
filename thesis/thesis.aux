\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Out-of-sample performance of the unregularized overlay (Overlay) and joint (Joint) optimizers and the equally weighted portfolio (EW) in the small (Panel A), medium (Panel B), and large (Panel C) investable universes. Columns are grouped by the minimized risk measure: variance, semi-variance, mean absolute deviation (MAD), Expected Shortfall (ES), and second-order Expected Shortfall (SOES). The metrics are the annualized excess return over the risk-free rate (ER), volatility (Vol), maximum drawdown (MD), Sharpe ratio (SR), Sortino ratio (SOR), and average asset (Turnover$^a$) and currency (Turnover$^c$) turnover. Portfolios are rebalanced quarterly, returns are net of transaction costs, and the out-of-sample period runs from July 2000 to April 2023. Additionally, the realized semi-deviation, MAD, ES, and SOES for the optimizers are reported in \Cref  {tab:additional-baseline}.}}{24}{table.5.1}\protected@file@percent }
\newlabel{tab:baseline}{{5.1}{24}{Out-of-sample performance of the unregularized overlay (Overlay) and joint (Joint) optimizers and the equally weighted portfolio (EW) in the small (Panel A), medium (Panel B), and large (Panel C) investable universes. Columns are grouped by the minimized risk measure: variance, semi-variance, mean absolute deviation (MAD), Expected Shortfall (ES), and second-order Expected Shortfall (SOES). The metrics are the annualized excess return over the risk-free rate (ER), volatility (Vol), maximum drawdown (MD), Sharpe ratio (SR), Sortino ratio (SOR), and average asset (Turnover$^a$) and currency (Turnover$^c$) turnover. Portfolios are rebalanced quarterly, returns are net of transaction costs, and the out-of-sample period runs from July 2000 to April 2023. Additionally, the realized semi-deviation, MAD, ES, and SOES for the optimizers are reported in \Cref {tab:additional-baseline}}{table.5.1}{}}
\newlabel{tab:baseline@cref}{{[table][1][5]5.1}{[1][23][]24}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Cumulative performance of the unregularized joint optimizers and their return difference to the overlay optimizers in the small investable universe (top 10 stocks per economy). The top panel shows the cumulative wealth of the joint optimizer of each risk measure and of the equally weighted portfolio (EW), and the bottom panel the cumulative sum of the daily return differences between the joint and the overlay optimizers. Portfolios are rebalanced quarterly, and returns are net of transaction costs. The performance metrics are reported in Panel A of \Cref  {tab:baseline}.}}{25}{figure.5.1}\protected@file@percent }
\newlabel{fig:baseline-top10}{{5.1}{25}{Cumulative performance of the unregularized joint optimizers and their return difference to the overlay optimizers in the small investable universe (top 10 stocks per economy). The top panel shows the cumulative wealth of the joint optimizer of each risk measure and of the equally weighted portfolio (EW), and the bottom panel the cumulative sum of the daily return differences between the joint and the overlay optimizers. Portfolios are rebalanced quarterly, and returns are net of transaction costs. The performance metrics are reported in Panel A of \Cref {tab:baseline}}{figure.5.1}{}}
\newlabel{fig:baseline-top10@cref}{{[figure][1][5]5.1}{[1][25][]25}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Cumulative performance of the unregularized joint optimizers and their return difference to the overlay optimizers in the medium investable universe (top 50 stocks per economy). Panels are as in \Cref  {fig:baseline-top10}. The performance metrics are reported in Panel B of \Cref  {tab:baseline}.}}{26}{figure.5.2}\protected@file@percent }
\newlabel{fig:baseline-top50}{{5.2}{26}{Cumulative performance of the unregularized joint optimizers and their return difference to the overlay optimizers in the medium investable universe (top 50 stocks per economy). Panels are as in \Cref {fig:baseline-top10}. The performance metrics are reported in Panel B of \Cref {tab:baseline}}{figure.5.2}{}}
\newlabel{fig:baseline-top50@cref}{{[figure][2][5]5.2}{[1][25][]26}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Cumulative performance of the unregularized joint optimizers and their return difference to the overlay optimizers in the large investable universe (top 100 stocks per economy). Panels are as in \Cref  {fig:baseline-top10}. The performance metrics are reported in Panel C of \Cref  {tab:baseline}.}}{26}{figure.5.3}\protected@file@percent }
\newlabel{fig:baseline-top100}{{5.3}{26}{Cumulative performance of the unregularized joint optimizers and their return difference to the overlay optimizers in the large investable universe (top 100 stocks per economy). Panels are as in \Cref {fig:baseline-top10}. The performance metrics are reported in Panel C of \Cref {tab:baseline}}{figure.5.3}{}}
\newlabel{fig:baseline-top100@cref}{{[figure][3][5]5.3}{[1][25][]26}{}{}{}}
