\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Change in the out-of-sample Sharpe ratio of the overlay and joint optimizers from regularization in the small, medium, and large investable universes. Panel A reports the absolute change, the Sharpe ratio of each regularized optimizer in \Cref  {tab:regularized-top10,tab:regularized-top50,tab:regularized-top100} minus that of its unregularized version in \Cref  {tab:baseline}, and Panel B the relative change in percent of the unregularized Sharpe ratio. Rows correspond to the minimized risk measure, and the last row of each panel reports the change of the average Sharpe ratio across the five risk measures.}}{28}{table.5.2}\protected@file@percent }
\newlabel{tab:regularization-sharpe-change}{{5.2}{28}{Change in the out-of-sample Sharpe ratio of the overlay and joint optimizers from regularization in the small, medium, and large investable universes. Panel A reports the absolute change, the Sharpe ratio of each regularized optimizer in \Cref {tab:regularized-top10,tab:regularized-top50,tab:regularized-top100} minus that of its unregularized version in \Cref {tab:baseline}, and Panel B the relative change in percent of the unregularized Sharpe ratio. Rows correspond to the minimized risk measure, and the last row of each panel reports the change of the average Sharpe ratio across the five risk measures}{table.5.2}{}}
