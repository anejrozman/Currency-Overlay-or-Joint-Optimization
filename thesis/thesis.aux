\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces Out-of-sample performance of the regularized overlay (Overlay) and joint (Joint) optimizers (Panel A1) and of the benchmarks (Panel B1) in the small investable universe (top 10 stocks per economy). The benchmarks are the equally weighted portfolio (EW) and the regularized asset-only optimizers Assets-Full (Full), which fully hedges the currency exposure of its assets, and Assets-Zero (Zero), which leaves it unhedged. Columns are grouped by the minimized risk measure: variance, semi-variance, mean absolute deviation (MAD), Expected Shortfall (ES), and second-order Expected Shortfall (SOES). The metrics are the annualized excess return over the risk-free rate (ER), volatility (Vol), maximum drawdown (MD), Sharpe ratio (SR), Sortino ratio (SOR), and average asset (Turnover$^a$) and currency (Turnover$^c$) turnover. Portfolios are rebalanced quarterly, returns are net of transaction costs, and the out-of-sample period runs from July 2000 to April 2023. Additionally, the realized semi-deviation, MAD, ES, and SOES for the optimizers are reported in \Cref  {tab:additional-regularized}.}}{29}{table.5.3}\protected@file@percent }
\newlabel{tab:regularized-top10}{{5.3}{29}{Out-of-sample performance of the regularized overlay (Overlay) and joint (Joint) optimizers (Panel A1) and of the benchmarks (Panel B1) in the small investable universe (top 10 stocks per economy). The benchmarks are the equally weighted portfolio (EW) and the regularized asset-only optimizers Assets-Full (Full), which fully hedges the currency exposure of its assets, and Assets-Zero (Zero), which leaves it unhedged. Columns are grouped by the minimized risk measure: variance, semi-variance, mean absolute deviation (MAD), Expected Shortfall (ES), and second-order Expected Shortfall (SOES). The metrics are the annualized excess return over the risk-free rate (ER), volatility (Vol), maximum drawdown (MD), Sharpe ratio (SR), Sortino ratio (SOR), and average asset (Turnover$^a$) and currency (Turnover$^c$) turnover. Portfolios are rebalanced quarterly, returns are net of transaction costs, and the out-of-sample period runs from July 2000 to April 2023. Additionally, the realized semi-deviation, MAD, ES, and SOES for the optimizers are reported in \Cref {tab:additional-regularized}}{table.5.3}{}}
\newlabel{tab:regularized-top10@cref}{{[table][3][5]5.3}{[1][28][]29}{}{}{}}
