\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces In-sample and out-of-sample relative gaps between the unregularized joint and overlay optimizers, by risk measure and universe size. Each panel shows one risk measure, with the size of the investable universe on the horizontal axis and the risk reduction of the joint optimizer over the overlay optimizer on the vertical axis. Squares mark the mean across the $T = 91$ quarterly rebalancing dates, in blue for the in-sample gap $\tilde  g_t^{\text  {IS}}$ and in red for the out-of-sample gap $\tilde  g_t^{\text  {OOS}}$, and shaded areas mark the $95\%$ bootstrap confidence intervals.}}{50}{figure.6.1}\protected@file@percent }
\newlabel{fig:gap-measures}{{6.1}{50}{In-sample and out-of-sample relative gaps between the unregularized joint and overlay optimizers, by risk measure and universe size. Each panel shows one risk measure, with the size of the investable universe on the horizontal axis and the risk reduction of the joint optimizer over the overlay optimizer on the vertical axis. Squares mark the mean across the $T = 91$ quarterly rebalancing dates, in blue for the in-sample gap $\tilde g_t^{\text {IS}}$ and in red for the out-of-sample gap $\tilde g_t^{\text {OOS}}$, and shaded areas mark the $95\%$ bootstrap confidence intervals}{figure.6.1}{}}
\newlabel{fig:gap-measures@cref}{{[figure][1][6]6.1}{[1][49][]50}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces Unrealized in-sample advantage of unregularized joint optimization, $\tilde  g_t^{\text  {IS}} - \tilde  g_t^{\text  {OOS}}$, by risk measure and universe size. The reported quantity is the percentage advantage the joint optimizer has in sample minus the percentage advantage it realizes out of sample, measured in percentage points. Markers show the mean across the $91$ quarterly rebalancing dates, and shaded areas the $95\%$ bootstrap confidence intervals as in \Cref  {fig:gap-measures}. The deviation and tail measures are shown on separate panels with independent vertical scales, since the latter are an order of magnitude larger.}}{51}{figure.6.2}\protected@file@percent }
\newlabel{fig:delta-epsilon}{{6.2}{51}{Unrealized in-sample advantage of unregularized joint optimization, $\tilde g_t^{\text {IS}} - \tilde g_t^{\text {OOS}}$, by risk measure and universe size. The reported quantity is the percentage advantage the joint optimizer has in sample minus the percentage advantage it realizes out of sample, measured in percentage points. Markers show the mean across the $91$ quarterly rebalancing dates, and shaded areas the $95\%$ bootstrap confidence intervals as in \Cref {fig:gap-measures}. The deviation and tail measures are shown on separate panels with independent vertical scales, since the latter are an order of magnitude larger}{figure.6.2}{}}
\newlabel{fig:delta-epsilon@cref}{{[figure][2][6]6.2}{[1][50][]51}{}{}{}}
